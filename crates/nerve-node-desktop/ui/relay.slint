// Relay: both sides of a relay (docs/dev/node-link.md). This node can reach its
// centers through another node's relay: one link from that relay, pasted
// here. And this node can be a relay for nodes that reach no center
// themselves: its switch and address, the nodes it carries, each with its
// link, centers, limits and tunnels now.

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Store, Prefs } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, Banner, PageHeader, PageFrame, IconTile, InfoRow, ListRow,
    TextField, Field, Reveal, SectionTitle, Icon, Fit, ScrollBox,
} from "widgets.slint";
import { LimitRows, SaveRow } from "settings.slint";

export component RelayPage inherits PageFrame {
    gap: 0;
    PageHeader {
        icon: @image-url("icons/route.svg");
        title: "Relay";
        error-title: "The relay could not be read";
        error: Prefs.error;
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.reload();
            }
        }
    }

    // This node through a relay.
    Rectangle {
        height: Space.xxl;
    }
    SectionTitle {
        text: "This node through a relay";
        icon: @image-url("icons/link.svg");
    }
    Card {
        pad: Space.xl;
        gap: 0;
        HorizontalLayout {
            spacing: Space.lg;
            VerticalLayout {
                alignment: start;
                IconTile {
                    icon: @image-url("icons/route.svg");
                    tone: Prefs.via-relay ? Prefs.via-tone : Tone.accent;
                    solid: Prefs.via-relay;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: Prefs.via-relay ? "Through " + Prefs.via-address
                        : Prefs.proxy != "" ? "Through a proxy"
                        : "Direct";
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                    wrap: word-wrap;
                }
                Text {
                    text: Prefs.via-relay ? "As " + Prefs.via-node + ". " + Prefs.via-state
                        : Prefs.proxy != "" ? Prefs.proxy + ". A relay's link takes its place."
                        : "For a machine that reaches no center itself: paste the link a relay shows.";
                    color: Prefs.via-relay ? Theme.tone(Prefs.via-tone) : Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Space.sm;
                    if Prefs.via-relay: Button {
                        text: "Disconnect";
                        kind: ButtonKind.danger-soft;
                        small: true;
                        clicked => {
                            Prefs.disconnect();
                        }
                    }
                    Button {
                        text: Prefs.via-relay ? "New link…" : "Connect…";
                        icon: @image-url("icons/link.svg");
                        kind: Prefs.via-relay ? ButtonKind.secondary : ButtonKind.primary;
                        small: true;
                        clicked => {
                            Prefs.connect-start();
                        }
                    }
                }
            }
        }
        Reveal {
            shown: Prefs.via-relay && Prefs.proxy-problem != "";
            gap: Space.lg;
            Banner {
                tone: Tone.warn;
                text: Prefs.proxy-problem;
            }
        }
    }

    // This machine as a relay.
    Rectangle {
        height: Space.section;
    }
    SectionTitle {
        text: "This machine as a relay";
        icon: @image-url("icons/server.svg");
    }
    Card {
        pad: Space.xl;
        gap: 0;
        HorizontalLayout {
            spacing: Space.lg;
            VerticalLayout {
                alignment: start;
                IconTile {
                    icon: @image-url("icons/server.svg");
                    tone: Prefs.relay-listen != "" ? Tone.ok : Tone.neutral;
                    solid: Prefs.relay-listen != "";
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: Prefs.relay-listen != "" ? "On" : "Off";
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: Type.semibold;
                        vertical-alignment: center;
                    }
                    if Prefs.relay-listen != "": VerticalLayout {
                        alignment: center;
                        Pill {
                            text: Prefs.relay-listen;
                            tone: Tone.ok;
                            dot: true;
                        }
                    }
                }
                Text {
                    text: Prefs.relay-listen == "" ? "Nodes that reach no center themselves can reach this node's centers through it."
                        : Prefs.relay-status != "" ? Prefs.relay-status
                        : "The node takes it when it runs.";
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            if Prefs.relay-listen != "": VerticalLayout {
                alignment: center;
                Button {
                    text: "Turn off";
                    small: true;
                    clicked => {
                        Prefs.relay-off();
                    }
                }
            }
        }
        Reveal {
            shown: Prefs.relay-listen == "";
            gap: Space.lg;
            Field {
                label: "Listen on";
                hint: "An address and port of this machine; 0.0.0.0 is every address.";
                HorizontalLayout {
                    spacing: Space.md;
                    TextField {
                        horizontal-stretch: 1;
                        text <=> Prefs.relay-address;
                        mono: true;
                        label: "Listen on";
                        accepted => {
                            Prefs.relay-on();
                        }
                    }
                    Button {
                        text: "Turn on";
                        kind: ButtonKind.primary;
                        clicked => {
                            Prefs.relay-on();
                        }
                    }
                }
            }
        }
        Reveal {
            shown: Prefs.relay-pin != "" && Prefs.relay-listen != "";
            gap: Space.lg;
            InfoRow {
                label: "Its pin";
                value: Prefs.relay-pin;
                mono: true;
            }
        }
    }

    // The nodes it carries.
    Rectangle {
        height: Space.lg;
    }
    Card {
        pad: 0;
        gap: 0;
        HorizontalLayout {
            padding-left: Space.xl;
            padding-right: Space.lg;
            padding-top: Space.lg;
            padding-bottom: Space.md;
            spacing: Space.md;
            Text {
                horizontal-stretch: 1;
                text: Prefs.relay-nodes.length == 0 ? "No node uses this relay yet." : "Nodes that use it";
                color: Prefs.relay-nodes.length == 0 ? Theme.text-muted : Theme.text;
                font-size: Prefs.relay-nodes.length == 0 ? Type.small : Type.body;
                font-weight: Prefs.relay-nodes.length == 0 ? Type.regular : Type.semibold;
                vertical-alignment: center;
            }
            Button {
                text: "Add a node…";
                icon: @image-url("icons/plus.svg");
                kind: ButtonKind.primary;
                small: true;
                clicked => {
                    Prefs.relay-add();
                }
            }
        }
        ScrollBox {
            rows: Prefs.relay-nodes.length;
            // Taller rows: half of one more shows below the cut.
            long-height: 460px;
            for n[i] in Prefs.relay-nodes: ListRow {
                first: false;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/server.svg");
                        colorize: n.live != "" ? Theme.ok : Theme.text-muted;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        Text {
                            text: n.name;
                            color: Theme.text;
                            font-size: Type.small;
                            font-weight: Type.semibold;
                            font-family: Type.mono;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if n.live != "": VerticalLayout {
                            alignment: center;
                            Pill {
                                text: n.live;
                                tone: Tone.ok;
                                dot: true;
                            }
                        }
                    }
                    Text {
                        text: n.reach + (n.limits != "" ? "; " + n.limits : "");
                        color: Theme.text-muted;
                        font-size: Type.caption;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Space.xs;
                        Button {
                            text: "Centers and limits…";
                            small: true;
                            kind: ButtonKind.ghost;
                            clicked => {
                                Prefs.relay-edit(i);
                            }
                        }
                        Button {
                            text: "New link…";
                            small: true;
                            kind: ButtonKind.ghost;
                            clicked => {
                                Prefs.relay-token(n.name);
                            }
                        }
                        Button {
                            icon: @image-url("icons/trash.svg");
                            small: true;
                            kind: ButtonKind.ghost;
                            accessible-label: "Remove " + n.name;
                            clicked => {
                                Prefs.relay-remove(n.name);
                            }
                        }
                    }
                }
            }
        }
    }

    // What it carries now.
    Reveal {
        shown: Prefs.tunnels.length > 0;
        gap: Space.lg;
        Card {
            pad: 0;
            gap: 0;
            HorizontalLayout {
                padding-left: Space.xl;
                padding-top: Space.lg;
                padding-bottom: Space.md;
                Text {
                    text: "Linked now";
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                }
            }
            ScrollBox {
                rows: Prefs.tunnels.length;
                for t in Prefs.tunnels: ListRow {
                    first: false;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: @image-url("icons/activity.svg");
                            colorize: Theme.ok;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: t.node + " → " + t.center;
                        color: Theme.text;
                        font-size: Type.small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: t.from;
                        color: Theme.text-muted;
                        font-size: Type.caption;
                        font-family: Type.mono;
                        vertical-alignment: center;
                    }
                    Text {
                        min-width: 90px;
                        text: t.since;
                        color: Theme.text-muted;
                        font-size: Type.caption;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Its limits, while it is on.
    Reveal {
        shown: Prefs.relay-listen != "";
        gap: Space.lg;
        Card {
            pad: Space.xl;
            gap: 0;
            Text {
                text: "Tunnels";
                color: Theme.text;
                font-size: Type.body;
                font-weight: Type.semibold;
            }
            Reveal {
                shown: Prefs.limits-error != "";
                gap: Space.md;
                Banner {
                    tone: Tone.danger;
                    title: "Not saved";
                    text: Prefs.limits-error;
                }
            }
            VerticalLayout {
                padding-top: Space.lg;
                spacing: Space.lg;
                LimitRows {
                    group: "relay";
                    rows: Prefs.limits-relay;
                }
                SaveRow {
                    group: "relay";
                }
            }
        }
    }
}
