// Log: what the node did, newest first, as `nerve-node log --follow` gives
// it while the page is open: a filter bar, the lines one each with their
// time, and the picked line whole.

import { Theme, Type, Space, Radius, Tone, Shape } from "theme.slint";
import { Load, LogRow } from "data.slint";
import { Logs, Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, Banner, Loading, PageHeader, PageFrame, EmptyState, Segmented,
    StatusDot, Reveal, MoreFoot, TextField, CopyText, Split, ListPane, DetailsPane, ListCard, ListItem,
    DetailCard,
} from "widgets.slint";

export component LogPage inherits PageFrame {
    property <int> pick: Math.max(0, Math.min(Logs.pick, Logs.rows.length - 1));
    property <LogRow> picked: Logs.rows[root.pick];
    // How far back the page reads: the search finds words only there.
    property <string> reach-text: (Logs.search != "" ? "Searching the newest " : "The newest ") + Logs.read + " lines."
        + (Logs.limit < 1000 ? "" : " Older ones stay in the log file.");
    gap: 0;
    init => {
        Store.details-open = false;
    }
    PageHeader {
        icon: @image-url("icons/log.svg");
        title: "Log";
        error-title: "The log could not be read";
        error: Logs.error;
        Button {
            text: "Clear";
            icon: @image-url("icons/trash.svg");
            kind: ButtonKind.ghost;
            busy: Store.busy == "log-clear";
            clicked => {
                Logs.clear();
            }
        }
    }

    // The filter bar: everything or the problems, and words to find.
    Rectangle {
        height: Space.xl;
    }
    HorizontalLayout {
        spacing: Space.md;
        Segmented {
            options: ["All", "Problems"];
            current: Logs.problems-only ? 1 : 0;
            chosen(i) => {
                Logs.pick = -1;
                Logs.filter(i == 1);
            }
        }
        TextField {
            horizontal-stretch: 1;
            text <=> Logs.search;
            placeholder: "Search the messages";
            label: "Search the messages";
            edited => {
                Logs.pick = -1;
                Logs.searched();
            }
        }
    }

    if Logs.load == Load.loading && Logs.rows.length == 0: Loading {
        text: "Reading the log…";
    }

    Reveal {
        shown: Logs.load == Load.ready && Logs.rows.length == 0;
        gap: Space.lg;
        Card {
            EmptyState {
                icon: @image-url("icons/log.svg");
                title: Logs.search != "" ? "No line matches"
                    : Logs.problems-only ? "No problems" : "Nothing logged yet";
                text: Logs.search != "" ? "Change or clear the search."
                    : Logs.problems-only ? "No error or warning in the log."
                    : "The node writes its log while it runs.";
            }
            // The search reads only the newest lines: it can look further back.
            Reveal {
                shown: Logs.search != "" && Logs.read >= Logs.limit;
                MoreFoot {
                    text: root.reach-text;
                    more: Logs.limit < 1000;
                    clicked => {
                        Logs.more();
                    }
                }
            }
        }
    }

    Reveal {
        shown: Logs.rows.length > 0;
        gap: Space.lg;
        Split {
            ListPane {
                open: Store.details-open;
                least: 320px;
                share: 0.46;
                ListCard {
                    label: "Log";
                    step(d) => {
                        Logs.pick = Math.max(0, Math.min(Logs.rows.length - 1, root.pick + d));
                    }
                    Rectangle {
                        height: 6px;
                    }
                    for row[i] in Logs.rows: ListItem {
                        first: i == 0;
                        selected: i == root.pick;
                        label: row.level + ", " + row.when + ": " + row.msg;
                        clicked => {
                            Logs.pick = i;
                            Store.details-open = true;
                        }
                        VerticalLayout {
                            alignment: center;
                            StatusDot {
                                tone: row.tone;
                                size: 7px;
                            }
                        }
                        Text {
                            width: 78px;
                            text: row.when;
                            color: Theme.text-faint;
                            font-size: Type.caption;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-label: row.when-exact;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: row.msg;
                            color: Theme.text;
                            font-size: Type.small;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Reveal {
                        shown: Logs.read >= Logs.limit;
                        VerticalLayout {
                            padding-top: Space.md;
                            padding-left: Space.lg;
                            padding-right: Space.lg;
                            MoreFoot {
                                text: root.reach-text;
                                more: Logs.limit < 1000;
                                clicked => {
                                    Logs.more();
                                }
                            }
                        }
                    }
                }
            }
            DetailsPane {
                open: Store.details-open;
                view-top: root.view-top;
                view-height: root.view-height;
                back => {
                    Store.details-open = false;
                }
                DetailCard {
                    HorizontalLayout {
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            Pill {
                                text: root.picked.level;
                                tone: root.picked.tone;
                                dot: true;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.picked.when-exact;
                            color: Theme.text-muted;
                            font-size: Type.small;
                            vertical-alignment: center;
                        }
                    }
                    CopyText {
                        text: root.picked.msg;
                        copy-button: true;
                    }
                }
            }
        }
    }
}
