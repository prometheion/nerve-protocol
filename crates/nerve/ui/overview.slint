// Overview: whether the node runs, its service, its centers at a glance,
// and the switch that stops everything (panic) or allows it again (unlock).

import { Theme, Type, Space, Radius, Tone, Shape } from "theme.slint";
import { Page, Load } from "data.slint";
import { Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, StatusDot, IconTile, Banner, Loading, PageHeader,
    PageFrame, Icon, Reveal, Split, ListPane, DetailsPane, SidePane, ListGroup, EmptyState,
} from "widgets.slint";
import { CenterList, CenterDetails } from "centers.slint";

// One fact of the node at a glance: its icon, name, value and a word more.
component Fact inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <Tone> tone: Tone.accent;
    spacing: Space.sm;
    VerticalLayout {
        alignment: center;
        Icon {
            source: root.icon;
            colorize: Theme.tone(root.tone);
        }
    }
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Type.small;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Type.small;
        font-weight: Type.semibold;
        vertical-alignment: center;
    }
    if root.detail != "": Text {
        text: "· " + root.detail;
        color: Theme.text-faint;
        font-size: Type.small;
        vertical-alignment: center;
    }
}

// The installed service: its state, and starting and stopping it.
// Starting and stopping the service.
component ServiceButtons inherits HorizontalLayout {
    spacing: Space.sm;
    if Store.service-state == "stopped" || Store.service-state == "failed": Button {
        text: "Start";
        icon: @image-url("icons/play.svg");
        kind: ButtonKind.primary;
        busy: Store.busy == "service-start";
        clicked => {
            Store.service("start");
        }
    }
    if Store.service-state == "running": Button {
        text: "Restart";
        icon: @image-url("icons/refresh.svg");
        kind: ButtonKind.secondary;
        busy: Store.busy == "service-restart";
        enabled: Store.busy != "service-stop";
        clicked => {
            Store.service("restart");
        }
    }
    if Store.service-state == "running": Button {
        text: "Stop";
        icon: @image-url("icons/stop.svg");
        busy: Store.busy == "service-stop";
        enabled: Store.busy != "service-restart";
        clicked => {
            Store.service("stop");
        }
    }
}

component ServiceCard inherits Card {
    pad: Space.xl;
    HorizontalLayout {
        spacing: Space.lg;
        VerticalLayout {
            alignment: center;
            IconTile {
                icon: @image-url("icons/server.svg");
                tone: Store.service-state == "running" ? Tone.ok
                    : Store.service-state == "failed" ? Tone.danger
                    : Store.service-state == "stopped" ? Tone.warn
                    : Tone.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                Text {
                    text: "Service";
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        dot: true;
                        text: Store.service-state == "running" ? "Running"
                            : Store.service-state == "failed" ? "Failed"
                            : Store.service-state == "stopped" ? "Stopped"
                            : Store.service-state == "starting" ? "Starting"
                            : "Stopping";
                        tone: Store.service-state == "running" ? Tone.ok
                            : Store.service-state == "failed" ? Tone.danger
                            : Store.service-state == "stopped" ? Tone.warn
                            : Tone.accent;
                    }
                }
            }
            Text {
                text: Store.service-state == "running" ? (Store.service-enabled ? "Runs as the user nerve and starts with the machine." : "Runs as the user nerve.")
                    : Store.service-state == "failed" ? "The Log says why."
                    : Store.service-state == "stopped" ? "No center reaches this machine while it is stopped."
                    : "One moment.";
                color: Theme.text-muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }
        // Beside the text on a small window, where the card is wide.
        if !Shape.roomy: VerticalLayout {
            alignment: center;
            ServiceButtons { }
        }
    }
    // Below it on a wide window, beside the node's state. The top row goes by the window (Shape.roomy), not by
    // whether the panes below fit: beside the node's state the card needs the room a 1100 px window gives.
    if Shape.roomy: HorizontalLayout {
        alignment: start;
        padding-left: 36px + Space.lg;
        ServiceButtons { }
    }
}

export component OverviewPage inherits PageFrame {
    property <bool> service-shown: Store.service-state != "" && Store.service-state != "none";
    property <int> pick: Math.max(0, Math.min(Store.center-pick, Store.centers.length - 1));
    gap: 0;
    init => {
        Store.details-open = false;
    }
    PageHeader {
        icon: @image-url("icons/overview.svg");
        title: "Overview";
        error-title: "The node did not answer";
        error: Store.status-error;
        error-action: "Try again";
        error-acted => {
            Store.refresh();
        }
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.reload();
            }
        }
    }

    if Store.status-load == Load.loading && Store.status.state == "": Loading { }

    // The node's state, in its colour, and its service beside it on a
    // wide window, below it on a small one.
    Reveal {
        shown: Store.status.state != "";
        gap: Space.xl;
        HorizontalLayout {
            spacing: root.service-shown && Shape.roomy ? Space.lg : 0px;
        Rectangle {
            horizontal-stretch: 1.4;
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Theme.tone(Store.status.tone).transparentize(0.7);
            background: @linear-gradient(90deg, Theme.tone-soft(Store.status.tone) 0%, Theme.surface 70%);
            HorizontalLayout {
                padding: Space.xxl;
                spacing: Space.xl;
                VerticalLayout {
                    alignment: center;
                    IconTile {
                        size: 52px;
                        solid: true;
                        tone: Store.status.tone;
                        icon: Store.status.state == "locked" ? @image-url("icons/lock.svg")
                            : Store.status.state == "running" ? @image-url("icons/activity.svg")
                            : @image-url("icons/wait.svg");
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: Store.status.title;
                        color: Theme.tone(Store.status.tone);
                        font-size: 20px;
                        font-weight: Type.semibold;
                        wrap: word-wrap;
                    }
                    Reveal {
                        shown: Store.status.detail != "";
                        gap: 4px;
                        Text {
                            text: Store.status.detail;
                            color: Theme.text;
                            font-size: Type.body;
                            wrap: word-wrap;
                        }
                    }
                    Reveal {
                        shown: Store.status.confinement != "";
                        gap: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("icons/shield.svg");
                                    colorize: Theme.text-muted;
                                    size: 14px;
                                }
                            }
                            Text {
                                text: "Confinement: " + Store.status.confinement;
                                color: Theme.text-muted;
                                font-size: Type.caption;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Space.sm;
                        if Store.status.state == "locked": Button {
                            text: "Unlock";
                            icon: @image-url("icons/unlock.svg");
                            kind: ButtonKind.primary;
                            busy: Store.busy == "node";
                            clicked => {
                                Store.unlock();
                            }
                        }
                        if Store.status.state != "locked": Button {
                            text: "Panic";
                            icon: @image-url("icons/octagon.svg");
                            kind: ButtonKind.danger-soft;
                            busy: Store.busy == "node";
                            why-disabled: "Ends every link and runs nothing until you unlock";
                            clicked => {
                                Store.panic();
                            }
                        }
                    }
                }
            }
        }
            // Beside it: nothing of it counts while it is not.
            Rectangle {
                property <bool> here: root.service-shown && Shape.roomy;
                visible: self.here;
                horizontal-stretch: self.here ? 1 : 0;
                max-width: self.here ? 100000px : 0px;
                min-width: 0px;
                min-height: 0px;
                preferred-height: self.here ? beside.preferred-height : 0px;
                beside := ServiceCard {
                    height: parent.height;
                }
            }
        }
    }
    Reveal {
        shown: root.service-shown && !Shape.roomy;
        gap: Space.lg;
        ServiceCard { }
    }

    Reveal {
        shown: Store.service-state == "none";
        gap: Space.lg;
        Banner {
            tone: Tone.warn;
            title: "The service is not installed";
            text: "Open the downloaded nerve again to install it.";
        }
    }

    // Commands run without their limits: one line and what helps.
    Reveal {
        shown: Store.status.limits-off != "";
        gap: Space.lg;
        Banner {
            tone: Tone.warn;
            title: "Commands run without limits";
            text: Store.status.limits-off;
            action: Store.status.limits-restart && Store.service-state == "running" ? "Restart" : "Why?";
            acted => {
                if (Store.status.limits-restart && Store.service-state == "running") {
                    Store.service("restart");
                } else {
                    Platform.open-url("https://github.com/prometheion/nerve-protocol/blob/" + Store.guide-ref + "/docs/user/settings.md#limits-per-command");
                }
            }
        }
    }

    Reveal {
        shown: Store.status.warnings.length > 0;
        gap: Space.lg;
        VerticalLayout {
            spacing: Space.sm;
            for warning in Store.status.warnings: Banner {
                tone: Tone.warn;
                text: warning;
            }
        }
    }

    // At a glance: the centers, sudo and the limits of a command.
    Reveal {
        shown: Store.status.state != "";
        gap: Space.lg;
        Card {
            pad: 0;
            FlexboxLayout {
                padding-left: Space.xl;
                padding-right: Space.xl;
                padding-top: Space.md;
                padding-bottom: Space.md;
                spacing-horizontal: 22px;
                spacing-vertical: Space.sm;
                Fact {
                    icon: @image-url("icons/centers.svg");
                    label: "Centers";
                    value: Store.status.centers == 0 ? "None"
                        : Store.status.centers + " paired";
                    detail: Store.status.state != "running" || Store.status.centers == 0 ? "None linked"
                        : Store.status.connected + " linked";
                    tone: Store.status.centers == 0 ? Tone.accent : Store.status.connected > 0 ? Tone.ok : Tone.warn;
                }
                Fact {
                    icon: @image-url("icons/key.svg");
                    label: "Sudo";
                    value: Store.status.sudo-on ? "On" : "Off";
                    detail: Store.status.sudo-on ? "Sudo list runs with sudo" : "";
                    tone: Store.status.sudo-on ? Tone.warn : Tone.ok;
                }
                Fact {
                    icon: @image-url("icons/cpu.svg");
                    label: "Limits per command";
                    value: Store.status.limits;
                    detail: "Memory · CPU · processes";
                }
            }
        }
    }

    Reveal {
        shown: Store.status.state != "" && Store.centers.length == 0;
        gap: Space.lg;
        Card {
            HorizontalLayout {
                spacing: Space.lg;
                Text {
                    horizontal-stretch: 1;
                    text: "No center paired yet.";
                    color: Theme.text-muted;
                    font-size: Type.body;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Button {
                    text: "Set up…";
                    kind: ButtonKind.ghost;
                    clicked => {
                        Store.setup-start();
                    }
                }
                Button {
                    text: "Pair a center";
                    icon: @image-url("icons/plus.svg");
                    kind: ButtonKind.primary;
                    clicked => {
                        Store.pair-start();
                    }
                }
            }
        }
    }

    // The centers, the picked one's details beside them, and on a large
    // window pairing one more.
    Reveal {
        shown: Store.status.state != "" && Store.centers.length > 0;
        gap: Space.lg;
        Split {
            side: true;
            ListPane {
                open: Store.details-open;
                CenterList {
                    manage: true;
                }
            }
            DetailsPane {
                open: Store.details-open;
                view-top: root.view-top;
                view-height: root.view-height;
                back => {
                    Store.details-open = false;
                }
                CenterDetails {
                    item: Store.centers[root.pick];
                    index: root.pick;
                }
            }
            SidePane {
                least: 300px;
                share: 0.24;
                Card {
                    HorizontalLayout {
                        spacing: Space.md;
                        VerticalLayout {
                            alignment: start;
                            IconTile {
                                icon: @image-url("icons/link.svg");
                                size: 32px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Pair a center";
                                color: Theme.text;
                                font-size: Type.heading;
                                font-weight: Type.semibold;
                            }
                            Text {
                                text: "Paste a center's pairing link, or open it on this machine.";
                                color: Theme.text-muted;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Pair a center";
                            icon: @image-url("icons/plus.svg");
                            kind: ButtonKind.primary;
                            clicked => {
                                Store.pair-start();
                            }
                        }
                    }
                }
            }
        }
    }
}
