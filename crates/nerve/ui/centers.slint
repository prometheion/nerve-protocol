// Centers: the paired centers in a list, and the picked one's details:
// pausing it, its new key, unpairing, its settings grant, and where its
// rights are; pairing a new one (the dialog is in dialogs.slint).

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Page, Load, CenterRow } from "data.slint";
import { Store, Perm, Caps } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, Banner, Loading, PageHeader, PageFrame, EmptyState, Switch,
    Reveal, Icon, StatusDot, Split, ListPane, DetailsPane, ListCard, ListGroup, ListItem, DetailCard,
    Fact,
} from "widgets.slint";

// The list of the paired centers: each one's state and mode on a second
// line. The page keeps which is picked (Store.center-pick).
export component CenterList inherits ListCard {
    // On the Overview: a button to the Centers page in the head.
    in property <bool> manage;
    label: "Centers";
    step(d) => {
        Store.center-pick = Math.max(0, Math.min(Store.centers.length - 1, Store.center-pick + d));
    }
    ListGroup {
        text: "Centers";
        count: Store.centers.length;
        if root.manage: Button {
            text: "Manage";
            kind: ButtonKind.ghost;
            small: true;
            clicked => {
                Store.show(Page.centers);
            }
        }
    }
    for c[i] in Store.centers: ListItem {
        tall: true;
        selected: i == Math.min(Store.center-pick, Store.centers.length - 1);
        label: c.name;
        clicked => {
            Store.center-pick = i;
            Store.details-open = true;
        }
        VerticalLayout {
            alignment: center;
            StatusDot {
                tone: c.link-tone;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: c.name;
                color: Theme.text;
                font-size: Type.body;
                font-weight: Type.semibold;
                overflow: elide;
            }
            Text {
                text: c.link + " · " + c.mode;
                color: Theme.text-muted;
                font-size: Type.small;
                overflow: elide;
            }
        }
    }
}

// One paired center: its link and buttons, its mode and settings grant,
// and the pages of what it may do here. When the node does not answer, it
// is what the node said last: greyed, and its buttons wait.
export component CenterDetails inherits DetailCard {
    in property <CenterRow> item;
    in property <int> index;
    property <bool> waiting: Store.busy == root.item.name;
    property <bool> stale: Store.status-load == Load.failed;
    opacity: root.stale ? 0.45 : 1;
    FlexboxLayout {
        spacing: Space.md;
        alignment: space-between;
        cross-axis-alignment: center;
        HorizontalLayout {
            spacing: Space.sm;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Type.title;
                font-weight: Type.semibold;
                vertical-alignment: center;
                overflow: elide;
                min-width: min(80px, self.preferred-width);
            }
            VerticalLayout {
                alignment: center;
                Pill {
                    text: root.item.link;
                    tone: root.item.link-tone;
                    dot: true;
                }
            }
        }
        HorizontalLayout {
            spacing: Space.sm;
            Button {
                text: root.item.paused ? "Resume" : "Pause";
                icon: root.item.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                enabled: !root.waiting && !root.stale;
                clicked => {
                    Store.center-pause(root.item.name, !root.item.paused);
                }
            }
            Button {
                text: "New key…";
                icon: @image-url("icons/key.svg");
                kind: ButtonKind.ghost;
                enabled: !root.waiting && !root.stale;
                clicked => {
                    Store.center-rotate(root.item.name);
                }
            }
            Button {
                text: "Unpair";
                icon: @image-url("icons/unlink.svg");
                kind: ButtonKind.danger-soft;
                enabled: !root.waiting && !root.stale;
                clicked => {
                    Store.center-unpair(root.item.name);
                }
            }
        }
    }
    Text {
        text: root.item.url;
        color: Theme.text-muted;
        font-size: Type.small;
        font-family: Type.mono;
        wrap: char-wrap;
    }
    Reveal {
        shown: root.item.note != "";
        Banner {
            tone: root.item.note-tone;
            text: root.item.note;
        }
    }
    VerticalLayout {
        padding-top: Space.xs;
        spacing: Space.lg;
        Fact {
            label: "Mode";
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.item.mode;
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                }
                Text {
                    text: root.item.mode-detail;
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Change";
                    small: true;
                    enabled: !root.stale;
                    clicked => {
                        Perm.pick(root.index);
                        Store.show(Page.policy);
                    }
                }
            }
        }
        Fact {
            label: "Settings grant";
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.item.settings-write ? "May change settings" : "Cannot change settings";
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                }
                Text {
                    text: !root.item.settings-write ? "Only you change what it may do."
                        : Perm.owner-is-root ? "Up to user mode, which runs as root on this node."
                        : "Up to user mode and sudo.";
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.item.settings-write;
                    enabled: !root.waiting && !root.stale;
                    label: "Settings grant of " + root.item.name;
                    toggled(on) => {
                        Store.center-grant(root.item.name, on);
                    }
                }
            }
        }
    }
    VerticalLayout {
        spacing: Space.xs;
        Text {
            text: "What it may do here";
            color: Theme.text-muted;
            font-size: Type.small;
            font-weight: Type.semibold;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Space.xs;
            Button {
                text: "Permissions";
                icon: @image-url("icons/arrow-right.svg");
                kind: ButtonKind.ghost;
                small: true;
                enabled: !root.stale;
                clicked => {
                    Perm.pick(root.index);
                    Store.show(Page.policy);
                }
            }
            Button {
                text: "Capabilities";
                icon: @image-url("icons/arrow-right.svg");
                kind: ButtonKind.ghost;
                small: true;
                enabled: !root.stale;
                clicked => {
                    Caps.pick(root.index);
                    Store.show(Page.capabilities);
                }
            }
        }
    }
}

export component CentersPage inherits PageFrame {
    property <int> pick: Math.max(0, Math.min(Store.center-pick, Store.centers.length - 1));
    gap: 0;
    init => {
        Store.details-open = false;
    }
    PageHeader {
        icon: @image-url("icons/centers.svg");
        title: "Centers";
        error-title: "The centers could not be read";
        error: Store.status-error;
        error-action: "Try again";
        error-acted => {
            Store.refresh();
        }
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.reload();
            }
        }
        Button {
            text: "Pair a center";
            icon: @image-url("icons/plus.svg");
            kind: ButtonKind.primary;
            clicked => {
                Store.pair-start();
            }
        }
    }

    if Store.status-load == Load.loading && Store.status.state == "": Loading { }

    Reveal {
        shown: Store.status.state != "" && Store.centers.length == 0;
        gap: Space.xxl;
        Card {
            EmptyState {
                icon: @image-url("icons/link.svg");
                title: "No center paired yet";
                text: "In the center's web UI, press Pair a machine, copy the link and paste it here.";
                Button {
                    text: "Pair a center";
                    icon: @image-url("icons/plus.svg");
                    kind: ButtonKind.primary;
                    clicked => {
                        Store.pair-start();
                    }
                }
            }
        }
    }

    Reveal {
        shown: Store.status.pairings-warning != "";
        gap: Space.xl;
        Banner {
            tone: Tone.warn;
            title: "The pairings are not kept apart";
            text: Store.status.pairings-warning;
        }
    }

    Reveal {
        shown: Store.centers.length > 0 && Store.status-load == Load.failed;
        gap: Space.xl;
        Text {
            text: "Last known state: the node does not answer.";
            color: Theme.text-muted;
            font-size: Type.small;
            wrap: word-wrap;
        }
    }

    Reveal {
        shown: Store.centers.length > 0;
        gap: Space.xl;
        Split {
            ListPane {
                open: Store.details-open;
                CenterList { }
            }
            DetailsPane {
                open: Store.details-open;
                view-top: root.view-top;
                view-height: root.view-height;
                back => {
                    Store.details-open = false;
                }
                CenterDetails {
                    item: Store.centers[root.pick];
                    index: root.pick;
                }
            }
        }
    }
}
