// Audit: every decision of the node, newest first (or oldest), filtered and
// counted, with the four buttons of issue #23 on a call: allow, allow as
// wildcard, deny, deny as wildcard; and on a call with arguments a rule may
// pin, the pin of one of them with allow and deny (#152, C1).
// They write the rule `nerve-node rule add --action` writes, the one the
// center's audit page writes.

import { Theme, Type, Space, Radius, Tone, Shape } from "theme.slint";
import { Load, AuditRow } from "data.slint";
import { Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, IconTile, Banner, Loading, PageHeader, PageFrame,
    EmptyState, Segmented, Code, Reveal, MoreFoot, TextField, Picker, Icon, Split, ListPane,
    DetailsPane, ListCard, ListItem, DetailCard,
} from "widgets.slint";

// The icon of an entry, by its kind and its decision.
global Kinds {
    public pure function icon(entry: AuditRow) -> image {
        return entry.kind == "call" ? (entry.tone == Tone.danger ? @image-url("icons/ban.svg") : @image-url("icons/check.svg"))
        : entry.kind == "settings" ? @image-url("icons/sliders.svg")
        : entry.kind == "relay" ? @image-url("icons/globe.svg")
        : entry.kind == "key" ? @image-url("icons/key.svg")
        : entry.kind == "config" ? @image-url("icons/edit.svg")
        : entry.kind == "audit" ? @image-url("icons/trash.svg")
        : @image-url("icons/info.svg");
    }
}

// The picked entry whole: what it was about, why, and on a call the
// buttons that make a rule of it.
component AuditDetails inherits DetailCard {
    in property <AuditRow> entry;
    property <bool> waiting: Store.busy == "audit-" + root.entry.index;
    // The argument the pin buttons hold the rule to.
    property <int> pin: 0;
    HorizontalLayout {
        spacing: Space.md;
        VerticalLayout {
            alignment: center;
            IconTile {
                size: 36px;
                tone: root.entry.tone;
                icon: Kinds.icon(root.entry);
            }
        }
        Text {
            text: root.entry.title;
            color: Theme.text;
            font-size: Type.title;
            font-weight: Type.semibold;
            font-family: root.entry.kind == "call" ? Type.mono : "";
            vertical-alignment: center;
            overflow: elide;
            min-width: min(80px, self.preferred-width);
        }
        if root.entry.badge != "": VerticalLayout {
            alignment: center;
            Pill {
                text: root.entry.badge;
                tone: root.entry.tone;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: (root.entry.center != "" ? root.entry.center + " · " : "") + root.entry.when;
            color: Theme.text-muted;
            font-size: Type.small;
            vertical-alignment: center;
            overflow: elide;
            accessible-label: root.entry.when-exact;
        }
    }
    // Its parts come and go with the entry (see Reveal).
    VerticalLayout {
        Reveal {
            shown: root.entry.target != "";
            Code {
                text: root.entry.target;
            }
        }
        Reveal {
            shown: root.entry.detail != "";
            gap: root.entry.target != "" ? Space.md : 0px;
            Text {
                text: root.entry.detail;
                color: Theme.text-muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }
        Text {
            text: root.entry.when-exact;
            color: Theme.text-faint;
            font-size: Type.caption;
        }
        Reveal {
            shown: root.entry.rules;
            gap: Space.xl;
            VerticalLayout {
                spacing: Space.sm;
                Text {
                    text: "A rule for next time";
                    color: Theme.text;
                    font-size: Type.small;
                    font-weight: Type.semibold;
                }
                FlexboxLayout {
                    spacing: 6px;
                    Button {
                        text: "Allow";
                        icon: @image-url("icons/check.svg");
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "allow", false);
                        }
                    }
                    Button {
                        text: "Allow as wildcard";
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "allow", true);
                        }
                    }
                    Button {
                        text: "Deny";
                        icon: @image-url("icons/ban.svg");
                        kind: ButtonKind.danger-soft;
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "deny", false);
                        }
                    }
                    Button {
                        text: "Deny as wildcard";
                        kind: ButtonKind.danger-soft;
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "deny", true);
                        }
                    }
                }
            }
        }
        // One argument of the call pinned: the rule holds that value
        // (lamp.set:room=office).
        Reveal {
            shown: root.entry.rules && root.entry.pins.length > 0;
            gap: Space.sm;
            FlexboxLayout {
                spacing: 6px;
                Picker {
                    options: root.entry.pins;
                    current: min(root.pin, max(0, root.entry.pins.length - 1));
                    label: "The argument to pin";
                    chosen(i) => {
                        root.pin = i;
                    }
                }
                Button {
                    text: "Allow with this value";
                    small: true;
                    enabled: !root.waiting;
                    clicked => {
                        Store.audit-pin(root.entry.index, "allow", root.pin);
                    }
                }
                Button {
                    text: "Deny with this value";
                    kind: ButtonKind.danger-soft;
                    small: true;
                    enabled: !root.waiting;
                    clicked => {
                        Store.audit-pin(root.entry.index, "deny", root.pin);
                    }
                }
            }
        }
        Reveal {
            shown: !root.entry.rules && root.entry.rules-why != "";
            gap: Space.lg;
            Text {
                text: root.entry.rules-why;
                color: Theme.text-faint;
                font-size: Type.caption;
                wrap: word-wrap;
            }
        }
    }
}

// The filter bar: what kind of decision (with its count), the order,
// words to find, a center and an action. They combine; a new filter picks
// the first entry again.
component AuditFilters inherits VerticalLayout {
    spacing: Space.md;
    HorizontalLayout {
        spacing: Space.md;
        Segmented {
            options: [
                "All " + Store.audit-counts[0],
                "Allowed " + Store.audit-counts[1],
                "Refused " + Store.audit-counts[2],
                "Changes " + Store.audit-counts[3],
            ];
            current: Store.audit-decision;
            chosen(i) => {
                Store.audit-decision = i;
                Store.audit-pick = -1;
                Store.audit-filtered();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Segmented {
            options: ["Newest first", "Oldest first"];
            current: Store.audit-oldest ? 1 : 0;
            chosen(i) => {
                Store.audit-oldest = i == 1;
                Store.audit-pick = -1;
                Store.audit-filtered();
            }
        }
    }
    HorizontalLayout {
        spacing: Space.md;
        TextField {
            horizontal-stretch: 1;
            text <=> Store.audit-text;
            placeholder: "Find in target and reason";
            label: "Find in target and reason";
            edited => {
                Store.audit-pick = -1;
                Store.audit-filtered();
            }
        }
        Picker {
            options: Store.audit-center-options;
            current: Store.audit-center;
            label: "Center";
            chosen(i) => {
                Store.audit-center = i;
                Store.audit-pick = -1;
                Store.audit-filtered();
            }
        }
        Picker {
            options: Store.audit-action-options;
            current: Store.audit-action;
            label: "Action";
            chosen(i) => {
                Store.audit-action = i;
                Store.audit-pick = -1;
                Store.audit-filtered();
            }
        }
    }
}

export component AuditPage inherits PageFrame {
    gap: 0;
    property <bool> filtered: Store.audit-decision != 0 || Store.audit-center != 0 || Store.audit-action != 0 || Store.audit-text != "";
    property <int> pick: Math.max(0, Math.min(Store.audit-pick, Store.audit.length - 1));
    init => {
        Store.details-open = false;
    }
    PageHeader {
        icon: @image-url("icons/audit.svg");
        title: "Audit";
        error-title: "The audit log could not be read";
        error: Store.audit-error;
        error-action: "Try again";
        error-acted => {
            Store.refresh-audit();
        }
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.reload();
            }
        }
        Button {
            text: "Clear";
            icon: @image-url("icons/trash.svg");
            kind: ButtonKind.ghost;
            busy: Store.busy == "audit-clear";
            clicked => {
                Store.audit-clear();
            }
        }
    }

    if Store.audit-load == Load.loading && Store.audit-read == 0: Loading {
        text: "Reading the audit log…";
    }

    Reveal {
        shown: Store.audit-read > 0;
        gap: Space.xl;
        AuditFilters { }
    }

    Reveal {
        shown: Store.audit-read > 0;
        gap: Space.md;
        HorizontalLayout {
            spacing: Space.md;
            Text {
                horizontal-stretch: 1;
                text: Store.audit-summary;
                color: Theme.text-muted;
                font-size: Type.small;
                vertical-alignment: center;
            }
            if root.filtered: Button {
                text: "Reset filters";
                kind: ButtonKind.ghost;
                small: true;
                clicked => {
                    Store.audit-decision = 0;
                    Store.audit-center = 0;
                    Store.audit-action = 0;
                    Store.audit-text = "";
                    Store.audit-pick = -1;
                    Store.audit-filtered();
                }
            }
        }
    }

    Reveal {
        shown: Store.audit-load == Load.ready && Store.audit-read == 0;
        gap: Space.xxl;
        Card {
            EmptyState {
                icon: @image-url("icons/audit.svg");
                title: "Nothing decided yet";
                text: "Each call of a center and each change of a setting shows here.";
            }
        }
    }

    Reveal {
        shown: Store.audit-read > 0 && Store.audit.length == 0;
        gap: Space.lg;
        Card {
            EmptyState {
                icon: @image-url("icons/audit.svg");
                title: "No entry matches";
                text: "Change or reset the filters.";
            }
        }
    }

    Reveal {
        shown: Store.audit.length > 0;
        gap: Space.lg;
        Split {
            ListPane {
                open: Store.details-open;
                stretch: Shape.large ? 1 : 5;
                least: 320px;
                most: 100000px;
                ListCard {
                    label: "Audit";
                    step(d) => {
                        Store.audit-pick = Math.max(0, Math.min(Store.audit.length - 1, root.pick + d));
                    }
                    Rectangle {
                        height: 6px;
                    }
                    for row[i] in Store.audit: ListItem {
                        first: i == 0;
                        selected: i == root.pick;
                        label: row.title + " " + row.badge + " " + row.target + ", " + row.when;
                        clicked => {
                            Store.audit-pick = i;
                            Store.details-open = true;
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: Kinds.icon(row);
                                colorize: row.tone == Tone.neutral ? Theme.text-muted : Theme.tone(row.tone);
                            }
                        }
                        Text {
                            text: row.title;
                            color: Theme.text;
                            font-size: Type.small;
                            font-family: row.kind == "call" ? Type.mono : "";
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: min(60px, self.preferred-width);
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: row.target != "" ? row.target : row.detail;
                            color: Theme.text-muted;
                            font-size: Type.small;
                            font-family: row.target != "" ? Type.mono : "";
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.when;
                            color: Theme.text-faint;
                            font-size: Type.caption;
                            vertical-alignment: center;
                            accessible-label: row.when-exact;
                        }
                    }
                    Reveal {
                        shown: Store.audit-foot != "";
                        VerticalLayout {
                            padding-top: Space.md;
                            padding-left: Space.lg;
                            padding-right: Space.lg;
                            MoreFoot {
                                text: Store.audit-foot;
                                more: Store.audit-more-left;
                                clicked => {
                                    Store.audit-more();
                                }
                            }
                        }
                    }
                }
            }
            DetailsPane {
                open: Store.details-open;
                stretch: Shape.large ? 1 : 6;
                view-top: root.view-top;
                view-height: root.view-height;
                back => {
                    Store.details-open = false;
                }
                AuditDetails {
                    entry: Store.audit[root.pick];
                }
            }
        }
    }
}
