// The design tokens of the node's desktop app: every colour, size, space and
// radius the pages use comes from here, so a page never picks its own and
// the app keeps one look. Light and dark follow the system's colour scheme
// (Palette.color-scheme), which the app can also set.

import { Palette } from "std-widgets.slint";

// What a colour means where it is used: a state, a decision, a button.
export enum Tone { neutral, accent, ok, warn, danger }

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces, from the window down to what sits on a card.
    out property <color> window: dark ? #0f1116 : #f4f5f9;
    // The sidebar carries a hint of the accent, so the app is not grey on
    // grey.
    out property <color> sidebar: dark ? #0d0f18 : #eceef8;
    out property <color> surface: dark ? #171a21 : #ffffff;
    out property <color> surface-alt: dark ? #1c2029 : #f6f7fb;
    out property <color> inset: dark ? #0f1116 : #f1f3f8;
    out property <color> hover: dark ? #ffffff0d : #0f172a0a;
    out property <color> pressed: dark ? #ffffff17 : #0f172a14;
    out property <color> selected: dark ? #ffffff12 : #ffffff;
    out property <color> scrim: dark ? #000000a6 : #0b0d1266;

    // Lines.
    out property <color> border: dark ? #262a32 : #e1e4ea;
    out property <color> border-strong: dark ? #363b46 : #c9ced7;
    // The track of a switch that is off: 3:1 against every surface (WCAG
    // 1.4.11), which the border above is not meant to reach.
    out property <color> switch-off: dark ? #656e7e : #78818f;

    // Text. Each meets WCAG AA (4.5:1) on every surface above, the faint
    // one too: no text of the app is too pale to read.
    out property <color> text: dark ? #eceef2 : #12151c;
    out property <color> text-muted: dark ? #b4bbc7 : #4a5262;
    out property <color> text-faint: dark ? #8a93a2 : #5f6776;

    // The app's own colour.
    out property <color> accent: dark ? #8b96ff : #4655d4;
    out property <color> accent-hover: dark ? #9ea8ff : #3b49c2;
    out property <color> accent-pressed: dark ? #7884f2 : #323fae;
    out property <color> accent-soft: dark ? #232849 : #eceefc;
    out property <color> accent-text: dark ? #b0b8ff : #3542b8;
    out property <color> on-accent: dark ? #0d1022 : #ffffff;

    // States.
    out property <color> ok: dark ? #4cd294 : #17784d;
    out property <color> ok-soft: dark ? #13301f : #e4f4eb;
    out property <color> warn: dark ? #eab554 : #93590a;
    out property <color> warn-soft: dark ? #33280f : #fcf1dd;
    out property <color> danger: dark ? #ff7a81 : #c0353d;
    out property <color> danger-hover: dark ? #ff888e : #b3323a;
    out property <color> danger-pressed: dark ? #f0646b : #9c2b32;
    out property <color> danger-soft: dark ? #3a1b1e : #fbeaeb;
    out property <color> on-danger: dark ? #1f0b0d : #ffffff;

    // The strong colour of a tone, for text, icons and dots.
    public pure function tone(t: Tone) -> color {
        if (t == Tone.accent) { return accent-text; }
        if (t == Tone.ok) { return ok; }
        if (t == Tone.warn) { return warn; }
        if (t == Tone.danger) { return danger; }
        return text-muted;
    }

    // The soft colour of a tone, for the background behind it.
    public pure function tone-soft(t: Tone) -> color {
        if (t == Tone.accent) { return accent-soft; }
        if (t == Tone.ok) { return ok-soft; }
        if (t == Tone.warn) { return warn-soft; }
        if (t == Tone.danger) { return danger-soft; }
        return surface-alt;
    }
}

// The type scale.
export global Type {
    out property <length> caption: 12px;
    out property <length> small: 13px;
    out property <length> body: 14px;
    out property <length> lead: 15px;
    out property <length> heading: 16px;
    out property <length> title: 22px;
    out property <length> display: 26px;

    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;

    // Commands, paths and rules: the system's monospace font, which the app
    // looks up when it starts (src/app.rs).
    in-out property <string> mono: "monospace";
}

// Spaces between and inside things, on a 4 px grid.
export global Space {
    out property <length> xxs: 2px;
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 20px;
    out property <length> xxl: 24px;
    out property <length> page: 32px;
    out property <length> section: 28px;
}

export global Radius {
    out property <length> sm: 6px;
    out property <length> md: 8px;
    out property <length> lg: 12px;
    out property <length> xl: 16px;
    out property <length> pill: 999px;
}

// Fixed sizes of the shell and the controls.
export global Size {
    out property <length> control: 34px;
    out property <length> control-sm: 28px;
    // A text field: a little taller than a button, for the text's room.
    out property <length> field: 38px;
    out property <length> icon: 16px;
    out property <length> icon-lg: 20px;
    out property <length> sidebar: 236px;
    // A page's width at most: a very wide window keeps margins on both
    // sides, a usual one uses its whole width.
    out property <length> page-max: 2000px;
    out property <length> dialog: 520px;
}

// The panes of the page's Split, side by side or folded (#213): a page
// shows one Split at a time, which says here how wide it is and whether it
// has a third pane (Split); its panes say their least widths and default
// shares (ListPane, DetailsPane, SidePane); and the app gives the shares
// the owner dragged on this page (`load`, from its settings). A column
// folds only when the panes no longer fit at their least widths. Between
// those points the panes stay joined, fill the width and keep their
// shares of it; a drag of the divider between two neighbours moves only
// those two, each down to its least width.
export global Panes {
    in-out property <length> width: 1000px;
    // The page has a third pane, before the list (`side-leading`) or after
    // the details.
    in-out property <bool> side;
    in-out property <bool> side-leading;
    in-out property <length> side-least: 180px;
    in-out property <length> list-least: 260px;
    in-out property <length> details-least: 360px;
    // The share of the whole a third pane takes, and the list's of the list
    // and the details, until the owner drags them.
    in-out property <float> side-default: 0.15;
    in-out property <float> list-default: 0.3;
    // The details hold a form: a list that is no wider than it needs gives
    // it the room.
    in-out property <bool> form;
    // What the owner dragged; below 0 the page's default.
    in-out property <float> list-share: -1;
    in-out property <float> side-share: -1;
    // A divider is being dragged.
    out property <bool> dragging;
    out property <length> gap: Space.lg;
    out property <bool> two: root.width >= root.list-least + root.gap + root.details-least;
    out property <bool> three: root.side && root.width >= root.side-least + root.list-least + root.details-least + 2 * root.gap;
    property <float> side-now: root.side-share >= 0 ? root.side-share : root.side-default;
    property <float> list-now: root.list-share >= 0 ? root.list-share
        : root.form ? min(root.list-default, 0.34) : root.list-default;
    out property <length> side-width: !root.three ? 0px
        : clamp(root.width * root.side-now, root.side-least, root.width - root.list-least - root.details-least - 2 * root.gap);
    // The list and the details together, without the gap between them.
    out property <length> both: root.width - (root.three ? root.side-width + root.gap : 0px) - root.gap;
    out property <length> list-width: !root.two ? root.width
        : clamp(root.both * root.list-now, root.list-least, root.both - root.details-least);
    out property <length> details-width: !root.two ? root.width : root.both - root.list-width;
    // The app reads the page's shares from its settings, and keeps them.
    callback load();
    callback save();
    // The widths when a drag began.
    property <length> from-side;
    property <length> from-list;
    property <length> from-details;
    public function grab() {
        root.from-side = root.side-width;
        root.from-list = root.list-width;
        root.from-details = root.details-width;
        root.dragging = true;
    }
    // The divider between the list and the details, `dx` from where it was
    // grabbed: the list grows by what the details give up.
    public function drag-list(dx: length) {
        let list = clamp(root.from-list + dx, root.list-least, root.from-list + root.from-details - root.details-least);
        root.list-share = list / root.both;
    }
    // The divider of the third pane: with the list where it leads, else
    // with the details. The pane on the other side keeps its width.
    public function drag-side(dx: length) {
        let side = root.side-leading
            ? clamp(root.from-side + dx, root.side-least, root.from-side + root.from-list - root.list-least)
            : clamp(root.from-side - dx, root.side-least, root.from-side + root.from-details - root.details-least);
        let both = root.width - side - 2 * root.gap;
        let list = root.side-leading ? root.from-list - (side - root.from-side) : root.from-list;
        root.side-share = side / root.width;
        root.list-share = list / both;
    }
    public function let-go() {
        root.dragging = false;
        root.save();
    }
    // A double-click on a divider: the page's defaults again.
    public function reset() {
        root.list-share = -1;
        root.side-share = -1;
        root.save();
    }
}

// The window's width, which the pages follow (the window sets it), and
// whether the page's panes stand side by side (`wide`) and with a third
// one (`large`): where they fit at their least widths (Panes), not at fixed
// widths.
export global Shape {
    in-out property <length> window-width: 1180px;
    out property <bool> wide: Panes.two;
    out property <bool> large: Panes.three;
    // A window with room for the page's wide margins.
    out property <bool> roomy: root.window-width >= 1100px;
}

// How things move: every animation of the app takes its time from here, and
// its curve from Curve below, so they are short and alike. Nothing moves (0 ms, the loops
// stand still) until the app knows that the desktop does not ask for less
// motion (src/motion.rs); the tests and the screenshots, which leave it off,
// draw each state at once.
export global Motion {
    in-out property <bool> on;

    // The colour of a hover or a press, a box ticked.
    out property <duration> quick: on ? 100ms : 0ms;
    // A switch, a section that opens, a toast, the steps' dots.
    out property <duration> base: on ? 150ms : 0ms;
    // A page or a dialog that comes in.
    out property <duration> enter: on ? 200ms : 0ms;
    // A dialog or a toast that goes: quicker than it came.
    out property <duration> leave: on ? 120ms : 0ms;
    // How far a page, a dialog or a toast rises while it comes in.
    out property <length> rise: on ? 8px : 0px;

    // One round of the loops that show waiting: the loading dots, the
    // spinner.
    out property <duration> pulse: 1100ms;
    out property <duration> spin: 900ms;
}

// The curve of every animation, with the times of Motion: fast at first,
// gentle at the end, so what comes in settles. A global of its own, as
// Slint gives a curve no way to the Rust side, where Motion goes.
export global Curve {
    out property <easing> ease: ease-out-quart;
}
