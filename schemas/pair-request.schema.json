{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prometheion/nerve-protocol/schemas/pair-request.schema.json",
  "title": "POST /nerve/v0/pair body",
  "type": "object",
  "required": ["code", "name", "platform", "arch", "public_key"],
  "additionalProperties": false,
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Za-z0-9]{1,64}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"},
    "platform": {"type": "string"},
    "arch": {"type": "string"},
    "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
