{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prometheion/nerve-protocol/schemas/descriptor.schema.json",
  "title": "Nerve node descriptor, protocol \"0\"",
  "type": "object",
  "required": ["nerve", "node", "rev", "capabilities"],
  "properties": {
    "nerve": {"const": "0"},
    "node": {
      "type": "object",
      "required": ["id", "name", "platform", "arch", "software"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z2-7]{26}$"},
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"},
        "platform": {"type": "string"},
        "arch": {"type": "string"},
        "software": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
        }
      }
    },
    "rev": {"type": "integer", "minimum": 0},
    "summary": {"type": "string"},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "access": {"$ref": "#/$defs/access"}
  },
  "$defs": {
    "access": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["allowlist", "folder", "user"]},
        "until_ms": {"type": "integer", "minimum": 0},
        "account": {"type": "string"},
        "confined": {"type": "boolean"},
        "sudo": {"type": "boolean", "default": false},
        "reads_by_account": {"type": "boolean", "default": false},
        "unnamed": {"type": "integer", "minimum": 0, "default": 0},
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "access"],
            "properties": {
              "path": {"type": "string"},
              "access": {"type": "string", "pattern": "^r?w?x?$", "minLength": 1},
              "own": {"type": "boolean", "default": false},
              "closed_below": {"type": "boolean", "default": false}
            }
          }
        }
      }
    },
    "effect": {"enum": ["read", "sense", "write", "actuate", "execute"]},
    "capability": {
      "type": "object",
      "required": ["id", "exposure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "profile": {"type": "string"},
        "provider": {"type": "string", "default": "node"},
        "exposure": {"enum": ["on", "off"]},
        "summary": {"type": "string"},
        "actions": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "additionalProperties": {
            "type": "object",
            "required": ["effect"],
            "properties": {
              "effect": {"$ref": "#/$defs/effect"},
              "summary": {"type": "string"},
              "params": {"type": "object"},
              "result": {"type": "object"},
              "exposure": {"enum": ["on", "off"]},
              "as_account": {"type": "boolean", "default": false}
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "summary": {"type": "string"},
              "implicit": {"type": "boolean"},
              "data": {"type": "object"}
            }
          }
        },
        "state": {"type": ["object", "null"]},
        "streams": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "direction"],
            "properties": {
              "kind": {"enum": ["reliable", "media"]},
              "direction": {"enum": ["up", "down", "both"]},
              "summary": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
