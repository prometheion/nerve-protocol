[
 {
  "tool": "exec_run",
  "args": {
   "command": "mkdir -p webui && cd webui && npm init -y >/dev/null && cat package.json",
   "cwd": "$WORK"
  }
 },
 {
  "tool": "fs_write",
  "args": {
   "path": "$WORK/webui/index.js",
   "content": "const http = require(\"http\");\n\nconst server = http.createServer((req, res) => {\n  res.writeHead(200, { \"Content-Type\": \"text/plain\" });\n  res.end(\"ok\\n\");\n});\n\nserver.listen(process.env.PORT || 3000, \"127.0.0.1\");\n"
  }
 },
 {
  "tool": "fs_write",
  "args": {
   "path": "$WORK/webui/test.js",
   "content": "const assert = require(\"assert\");\nassert.strictEqual(1 + 1, 2);\nconsole.log(\"tests passed\");\n"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "node test.js",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "node --version && npm --version",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "npm pkg set scripts.test='node test.js' && npm test",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "npm install --no-audit --no-fund left-pad@1.3.0",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "ls node_modules | head",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "npm ls --depth=0",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "rm -rf node_modules package-lock.json",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "timeout 3 node index.js; echo exit $?",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "npx --yes prettier --version || true",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "git init -q && printf 'node_modules/\\n' > .gitignore && git add -A && git commit -qm 'Start web UI' && git status",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "exec_run",
  "args": {
   "command": "cat .gitignore",
   "cwd": "$WORK/webui"
  }
 },
 {
  "tool": "fs_stat",
  "args": {
   "path": "$WORK/webui/package.json"
  }
 }
]
